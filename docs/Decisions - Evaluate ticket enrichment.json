    {
      "parameters": {
        "jsCode": "// Six support tickets covering every branch. In production, replace with a Webhook / helpdesk trigger.\nconst tickets = [\n  { id: 'T-101', from: 'ana@pixelforge.io', subject: 'Double charge, last warning',\n    body: \"This is the third time you have double-charged me. If this isn't refunded by Friday I'm contacting my lawyer and filing a chargeback.\" },\n  { id: 'T-102', from: 'ops@brightcart.com', subject: 'Webhooks failing with 504',\n    body: 'Our webhook deliveries have been failing since 9am with 504 errors. We process orders through it, so we need this looked at ASAP.' },\n  { id: 'T-103', from: 'sam@greenleaf.co', subject: 'Export still broken',\n    body: \"The export feature has been broken for a week and I'm honestly getting annoyed. I'd like a refund for this month.\" },\n  { id: 'T-104', from: 'finance@oakridge.org', subject: 'Invoice email address',\n    body: 'Is it possible to change the email address our invoices are sent to? No rush at all.' },\n  { id: 'T-105', from: 'lena@studio-nine.dev', subject: 'Annual discount?',\n    body: 'Do you offer an annual discount for teams of 15 people?' },\n  { id: 'T-106', from: 'mark@unknown-co.com', subject: 'Re: Re: issue',\n    body: 'Same issue as before.' },\n];\nreturn tickets.map(t => ({ json: t }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        560
      ],
      "id": "b745e4f5-a19f-459d-a95b-9b1802d7d0cc",
      "name": "Sample support tickets"
    },
    {
      "parameters": {
        "model": "typesafe/jev-1.13",
        "stateText": "=From: {{ $json.from }}\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "questions": {
          "question": [
            {
              "id": "is_urgent",
              "instructions": "Is the customer blocked right now, with a problem that needs attention today?",
              "trueMeans": "urgent",
              "falseMeans": "not_urgent"
            },
            {
              "id": "wants_refund",
              "instructions": "Is the customer asking for a refund or a credit?",
              "trueMeans": "refund",
              "falseMeans": "no_refund"
            },
            {
              "id": "legal_threat",
              "instructions": "Does the customer threaten legal action, a chargeback or a public complaint?",
              "trueMeans": "threat",
              "falseMeans": "no_threat"
            },
            {
              "type": "choice",
              "id": "team",
              "instructions": "Which team should handle this message?",
              "choiceOptions": {
                "option": [
                  {
                    "name": "billing",
                    "description": "Payments, payouts, invoices, refunds"
                  },
                  {
                    "name": "technical",
                    "description": "Bugs, outages, integrations, API errors"
                  },
                  {
                    "name": "sales",
                    "description": "Pricing, discounts, upgrades, new accounts"
                  }
                ]
              }
            },
            {
              "type": "score",
              "id": "frustration",
              "instructions": "How frustrated is the customer?",
              "scoreLevels": {
