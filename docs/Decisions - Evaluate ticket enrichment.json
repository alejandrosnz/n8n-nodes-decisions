                    "level": "Mildly annoyed"
                  },
                  {
                    "level": "Clearly frustrated"
                  },
                  {
                    "level": "Furious"
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-decisions.decisions",
      "typeVersion": 2,
