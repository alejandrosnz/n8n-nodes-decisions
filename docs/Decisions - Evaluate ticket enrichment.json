    {
      "parameters": {
        "jsCode": "// Business rules live in code: the Evaluate node only reports signals + probabilities.\n// Tune these thresholds to your own tolerance.\nconst T = { urgent: 0.8, refund: 0.7, legal: 0.7, frustrated: 2, minConfidence: 0.6 };\n\nreturn $input.all().map(({ json }) => {\n  const a = json.answers || {};\n  const urgent     = a.is_urgent?.noul ?? 0;\n  const refund     = a.wants_refund?.noul ?? 0;\n  const legal      = a.legal_threat?.noul ?? 0;\n  const frustration = a.frustration?.score ?? 0;\n  const team       = a.team?.choice ?? 'unknown';\n  const lowConfidence = (a.team?.confidence ?? 0) < T.minConfidence\n                     || (a.frustration?.confidence ?? 0) < T.minConfidence;\n\n  const signals = [];\n  if (urgent >= T.urgent) signals.push('urgent');\n  if (frustration >= T.frustrated) signals.push('frustrated');\n  if (refund >= T.refund) signals.push('refund_request');\n  if (legal >= T.legal) signals.push('legal_threat');\n\n  let route = 'p3';\n  if (urgent >= T.urgent || frustration >= T.frustrated) route = 'p2';\n  if (urgent >= T.urgent && frustration >= T.frustrated) route = 'p1';\n  if (legal >= T.legal) route = 'legal';\n  else if (lowConfidence) route = 'review';\n\n  return { json: { ...json, team, signals, route, reason: route === 'review' ? 'low_confidence' : undefined } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
