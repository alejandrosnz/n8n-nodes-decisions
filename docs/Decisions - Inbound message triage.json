    {
      "parameters": {
        "jsCode": "\n // Seven inbound messages covering every branch of the workflow.\n // In production, replace this node with a Webhook, IMAP or helpdesk trigger.\n\nconst messages = [\n  {\n    id: 1,\n    from: 'laura@atelier-lume.com',\n    subject: 'Payout failed again',\n    body: 'My payout has failed three days in a row and support chat keeps timing out. I need this fixed today.',\n  },\n  {\n    id: 2,\n    from: 'devops@northwind-labs.io',\n    subject: 'API returning 500s',\n    body: \"Since this morning's release our integration gets 500 errors on every call to /v2/orders. Our checkout is down and customers can't pay.\",\n  },\n  {\n    id: 3,\n    from: 'procurement@helixsoft.com',\n    subject: 'Pricing for 40 seats',\n    body: 'Hi, we trialed your product last month across two teams and the engineers want to standardize on it. Our current contract with the incumbent ends on the 30th. Can you send enterprise pricing for 40 seats and let me know if you can do a security review call this week?',\n  },\n  {\n    id: 4,\n    from: 'no-reply@seo-boost-now.biz',\n    subject: 'RANK #1 ON GOOGLE in 7 days!!!',\n    body: \"Congratulations! You've been selected for our exclusive SEO package. Reply within 24h to claim 90% off. Unsubscribe here.\",\n  },\n  {\n    id: 5,\n    from: 'tom.reyes@gmail.com',\n    subject: 'What does your product do?',\n    body: 'Hi, someone mentioned you in a Slack group. Just curious what it does, nothing planned for now.',\n  },\n  {\n    id: 6,\n    from: 'chris@brightpath.org',\n    subject: 'Re: Re: follow up',\n    body: 'Hey, it is me again. Same thing as last time, can you take a look when you have a chance? Thanks.',\n  },\n  {\n    id: 7,\n    from: 'accounts@kestrel-studio.com',\n    subject: 'Invoice copy',\n    body: 'Could you send me a PDF copy of invoice INV-2024-118? Our accountant needs it for the quarterly close, no rush.',\n  },\n];\n\n// Return one n8n item per message.\nreturn messages.map((message) => ({\n  json: message,\n}));\n"
      },
